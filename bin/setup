#!/usr/bin/env bash

# OpenCode Setup Script
# This script bootstraps OpenCode tool for a git repository.
#
# Requirements:
#  • Git, curl, and a bash-compatible shell

# ---

# This line is often referred to as the "Bash Unofficial Strict Mode"
#
# -e (errexit): Tells the script to exit immediately if a command exits with a non-zero status
#               (indicates an error). Without this, Bash keeps running the next line even if the
#               previous command failed.
# -i (nounset): Causes the script to exit if you try to use a variable that hasn't been defined.
#               This prevents disasters like "rm -rf /$DIR" if $DIR happens to be empty.
# -o pipefail: Ensures that if any command in a pipeline fails (e.g., step1 | step2 | step3), the whole
#              pipeline returns a failure code. Normally, Bash only cares if the last command in the pipe worked.
set -euo pipefail

# Requires Bash 4.2+ for associative arrays and global declarations.
if (( BASH_VERSINFO[0] < 4 )) || { (( BASH_VERSINFO[0] == 4 )) && (( BASH_VERSINFO[1] < 2 )); }
then
    echo "Error: Requires Bash 4.2 or higher." >&2
    echo "Current version: $BASH_VERSION" >&2
    exit 1
fi

# Phase 1: Resolve project root — clone to temp if running remotely
SCRIPT_SRC="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." 2>/dev/null && pwd)" || true

CLEANUP_TMP=false
if [[ -f "$SCRIPT_SRC/src/utils/_logger.sh" ]]
then
    ROOT_DIR="$SCRIPT_SRC"
else
    ROOT_DIR=$(mktemp -d)
    git clone --depth 1 \
        https://github.com/DuckKota/OpenCode-Bootstrapper.git \
        "$ROOT_DIR"
    CLEANUP_TMP=true
    trap '[[ "$CLEANUP_TMP" == "true" ]] && rm -rf "$ROOT_DIR"' EXIT INT TERM
fi

# Load helpers
source "$ROOT_DIR/src/utils/_logger.sh"
source "$ROOT_DIR/src/utils/_utils.sh"

function _ensure_git_project
{
    log::info "Ensuring Git repository..."
    CWD=$(pwd -P)
    if ! util::is_git_project "$CWD"
    then
        log::error "Not a Git repository: $CWD"
        log::error "Please run this script in the root of a Git project."
        exit 1
    fi
    GIT_DIR=$(git -C "$CWD" rev-parse --show-toplevel 2>/dev/null)
    GIT_DIR=$(cd "$GIT_DIR" && pwd -P)
    log::success "Git repository verified! ($GIT_DIR)"
    log::newline
}

function _ensure_openspec_installed
{
    log::info "Ensuring OpenSpec is installed..."
    if ! util::command_exists "openspec"
    then
        log::error "OpenSpec is not installed. Please install OpenSpec and try again."
        log::error "Install: npm install -g @fission-ai/openspec@latest"
        exit 1
    fi
    log::success "OpenSpec verified!"
    log::newline
}

function _ensure_codebase_memory_mcp_installed
{
    log::info "Ensuring codebase-memory-mcp is installed..."
    if ! util::command_exists "codebase-memory-mcp"
    then
        log::error "codebase-memory-mcp is not installed. Please install codebase-memory-mcp and try again."
        log::error "Install: curl -fsSL https://raw.githubusercontent.com/DeusData/codebase-memory-mcp/main/install.sh | bash -s -- --skip-config"
        exit 1
    fi
    log::success "codebase-memory-mcp verified!"
    log::newline
}

function _ensure_rtk_installed
{
    log::info "Ensuring rtk is installed..."
    if ! util::command_exists "rtk"
    then
        log::error "rtk is not installed. Please install rtk and try again."
        log::error "Install: curl -fsSL https://raw.githubusercontent.com/rtk-ai/rtk/refs/heads/master/install.sh | sh"
        exit 1
    fi
    log::success "rtk verified!"
    log::newline
}

function _update_gitignore
{
    if [[ ! -f "$GIT_DIR/.gitignore" ]] || ! grep -qF ".opencode/" "$GIT_DIR/.gitignore"
    then
        echo "" >> "$GIT_DIR/.gitignore"
        echo "# Ignore OpenCode" >> "$GIT_DIR/.gitignore"
        echo ".opencode/" >> "$GIT_DIR/.gitignore"
    fi
}

function _init_openspec
{
    log::info "Initializing OpenSpec..."
    openspec init --tools opencode
    log::success "OpenSpec initialized!"
    log::newline
}

function _init_agents_md
{
    local mode="$1"
    local src="$2"
    local dst="$3"

    if [[ "$mode" != "prepend" && "$mode" != "append" ]]
    then
        log::error "Usage: _init_agents_md <prepend|append> <source_file> <target_file>"
        return 1
    fi

    if [[ ! -f "$src" ]]
    then
        log::error "Source file not found: $src"
        return 1
    fi

    local content
    content=$(cat "$src")
    local marker
    marker=$(echo "$content" | head -n1)

    mkdir -p "$(dirname "$dst")"
    touch "$dst"

    if grep -qF "$marker" "$dst"
    then
        log::success "Content already exists in $dst, skipping"
        log::newline
    else
        local tmp_file
        tmp_file=$(mktemp)
        if [[ "$mode" == "append" ]]
        then
            cat "$dst" > "$tmp_file"
            echo "" >> "$tmp_file"
            echo "$content" >> "$tmp_file"
        else
            echo "$content" > "$tmp_file"
            echo "" >> "$tmp_file"
            cat "$dst" >> "$tmp_file"
        fi
        mv "$tmp_file" "$dst"
        log::success "Content written to $dst ($mode)"
        log::newline
    fi
}

function _init_codebase_memory_mcp
{
    log::info "Initializing codebase-memory-mcp..."

    local working_dir
    working_dir=$(pwd -P)
    if ! util::is_git_project "$working_dir"
    then
        log::warn "Not a Git repository: $working_dir"
        log::warn "Skipping codebase-memory-mcp"
        return 0
    fi
    local git_root
    git_root=$(git -C "$working_dir" rev-parse --show-toplevel 2>/dev/null)
    git_root=$(cd "$git_root" && pwd -P)

    # Ensure we found the codebase-memory-mcp executable
    local codebase_mcp_install_path="$(which codebase-memory-mcp)"
    if [[ -z "$codebase_mcp_install_path" ]]
    then
        log::error "command not found: codebase-memory-mcp"
        return 1
    fi

    # Initialize AGENTS.md with codebase-memory-mcp instructions
    _init_agents_md "prepend" "$ROOT_DIR/src/instructions/codebase-memory-mcp-agents.md" "$git_root/AGENTS.md"

    # This is custom plugin that I wrote, so I don't care to check that it already exists.
    mkdir -p "$git_root/.opencode/plugins"
    cp "$ROOT_DIR/src/plugins/CodebaseMemoryReminder.ts" "$git_root/.opencode/plugins"

    # Update the projects MCP server list
    mkdir -p "$git_root/.opencode"
    local python_exe
    python_exe="$(util::get_python_exe)"
    if [[ -z "$python_exe" ]]
    then
        log::error "command not found: python3 / python"
        return 1
    fi
    (cd "$git_root" && "$python_exe" -c "import json, os

file_path = '.opencode/opencode.json'

if not os.path.exists(file_path):
    with open(file_path, 'w') as f:
        f.write('{}')

try:
    with open(file_path, 'r+') as f:
        try:
            data = json.load(f)
        except json.JSONDecodeError:
            data = {}

        payload = {
            'codebase-memory-mcp': {
                'enabled': True,
                'type': 'local',
                'command': ['$codebase_mcp_install_path'],
            }
        }

        if 'mcp' not in data:
            data['mcp'] = payload
        else:
            if 'codebase-memory-mcp' not in data['mcp']:
                data['mcp']['codebase-memory-mcp'] = payload['codebase-memory-mcp']
            else:
                pass

        f.seek(0)
        json.dump(data, f, indent=4)
        f.truncate()
except Exception as e:
    print(f'Error updating file: {e}')
")

    codebase-memory-mcp config set auto_index true  # auto-index on session start
    codebase-memory-mcp config set auto_watch true  # register background git watcher

    log::success "codebase-memory-mcp initialized!"
    log::newline
}

function _init_rtk
{
    log::info "Initializing rtk..."
    echo "n" | rtk init --global --opencode
    log::success "rtk initialized!"
    log::newline
}

function _write_command
{
    if (( $# < 1 ))
    then
        echo "Error: Missing argument." >&2
        exit 1
    fi

    local command_name="$1"
    log::info "Globally installing $command_name command..."

    local src_command="$ROOT_DIR/src/commands/$command_name.md"
    local dst_command="$HOME/.config/opencode/commands/$command_name.md"

    if [[ -f "$dst_command" ]]
    then
        local command_current
        command_current=$(cat "$dst_command")
        local command_new
        command_new=$(cat "$src_command")
        if [[ "$command_current" == "$command_new" ]]
        then
            log::success "/$command_name command already set up in $dst_command"
            log::newline
        else
            log::warn "Skipping /$command_name command. Different command by the same name already exists: $dst_command"
            log::newline
        fi
    else
        mkdir -p "$(dirname "$dst_command")"
        cp "$src_command" "$dst_command"
        log::success "/$command_name command written to $dst_command"
        log::newline
    fi
}

function _write_skill
{
    if (( $# < 1 ))
    then
        echo "Error: Missing argument." >&2
        exit 1
    fi

    local skill_name="$1"
    log::info "Globally installing $skill_name skill..."

    local src_dir="$ROOT_DIR/src/skills/$skill_name"
    local dst_dir="$HOME/.config/opencode/skills/$skill_name"

    if [[ ! -d "$src_dir" ]]
    then
        log::error "Skill source not found: $src_dir"
        exit 1
    fi

    if [[ -d "$dst_dir" ]]
    then
        local any_diff=0
        local file rel_path current existing
        while IFS= read -r -d '' file
        do
            rel_path="${file#$src_dir/}"
            current=$(cat "$ROOT_DIR/src/skills/$skill_name/$rel_path")
            existing=$(cat "$dst_dir/$rel_path" 2>/dev/null)
            if [[ "$current" != "$existing" ]]
            then
                any_diff=1
                break
            fi
        done < <(find "$src_dir" -type f -print0)

        if (( any_diff == 0 ))
        then
            log::success "$skill_name skill already set up in $dst_dir"
            log::newline
        else
            log::warn "Skipping $skill_name skill. Different version already exists: $dst_dir"
            log::newline
        fi
        return 0
    fi

    local file rel_path target_file
    while IFS= read -r -d '' file
    do
        rel_path="${file#$src_dir/}"
        target_file="$dst_dir/$rel_path"
        mkdir -p "$(dirname "$target_file")"
        cp "$ROOT_DIR/src/skills/$skill_name/$rel_path" "$target_file"
    done < <(find "$src_dir" -type f -print0)

    log::success "$skill_name skill written to $dst_dir"
    log::newline
}

function _write_commit_message_command
{
    log::info "Globally installing commit-message command..."
    local src_command_path="$ROOT_DIR/src/commands/commit-message.md"
    local dst_command_path="$HOME/.config/opencode/commands/commit-message.md"
    local src_script_path="$ROOT_DIR/src/commands/verify-commit"
    local dst_script_path="$HOME/.config/opencode/scripts/verify-commit"

    if [[ -f "$dst_command_path" ]] || [[ -f "$dst_script_path" ]]
    then
        if [[ -f "$dst_command_path" ]] && [[ -f "$dst_script_path" ]]
        then
            local current_script new_script
            current_script=$(cat "$dst_script_path")
            new_script=$(cat "$src_script_path")

            local current_command new_command
            current_command=$(cat "$dst_command_path")
            new_command=$(cat "$src_command_path" | sed "s|<VALIDATE_COMMIT_SCRIPT>|$dst_script_path|g")

            if [[ "$current_command" == "$new_command" ]] && [[ "$current_script" == "$new_script" ]]
            then
                log::success "/commit-message command already set up in $dst_command_path"
                log::newline
                return 0
            fi
        fi

        log::warn "Skipping /commit-message command. Different version already exists in $dst_command_path"
        log::newline
    else
        mkdir -p "$(dirname "$dst_command_path")" "$(dirname "$dst_script_path")"
        cp "$src_command_path" "$dst_command_path"
        cp "$src_script_path" "$dst_script_path"
        chmod 755 "$dst_script_path"
        sed "s|<VALIDATE_COMMIT_SCRIPT>|$dst_script_path|g" "$dst_command_path" > "$dst_command_path.tmp" && mv "$dst_command_path.tmp" "$dst_command_path"
        log::success "/commit-message command written to $dst_command_path"
        log::newline
    fi
}


# ----------------------------------

log::box "System Pre-checks"
# _ensure_git_project
# _ensure_openspec_installed
_ensure_codebase_memory_mcp_installed
_ensure_rtk_installed

log::box "Initializing Tools"
# _update_gitignore
# _init_openspec
_init_codebase_memory_mcp
_init_rtk

log::box "Installing Commands"
_write_commit_message_command
_write_command "grill-me"
_write_command "handoff"

log::box "Installing Skills"
_write_skill "diagnosing-bugs"
_write_skill "codebase-design"
_write_skill "domain-modeling"
_write_skill "improve-codebase-architecture"
_write_skill "grilling"
_write_skill "using-git-worktrees"
_write_skill "verification-before-completion"

log::box "Installing Miscellaneous"
log::info "Globally installing Caveman speak..."
_init_agents_md "prepend" "$ROOT_DIR/src/instructions/caveman.md" "$HOME/.config/opencode/AGENTS.md"
log::info "Globally installing batch file write..."
_init_agents_md "append" "$ROOT_DIR/src/instructions/file-edit-limits.md" "$HOME/.config/opencode/AGENTS.md"

"$ROOT_DIR/src/utils/_print_duck.sh"
echo ""
log::box "  •  OpenCode Setup Complete  •  "