#!/usr/bin/env bash

# oc-setup
# Re-runs the OpenCode setup command. setup is idempotent, so this is safe to
# run repeatedly — use it in fresh projects to initialize OpenSpec,
# codebase-memory-mcp, and rtk.

set -euo pipefail

case "${1:-}" in
    init)
        curl -fsSL https://raw.githubusercontent.com/DuckKota/my-opencode-setup/refs/heads/main/bin/setup | bash
        ;;
    *)
        echo "Usage: oc-setup init" >&2
        echo "Re-runs my-opencode-setup" >&2
        exit 1
        ;;
esac

